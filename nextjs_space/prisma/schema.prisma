generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/construction_crm_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
  SuperAdmin
  Admin
  ProjectManager
  Superintendent
  FieldStaff
  Architect
  Engineer
  Owner
  Subcontractor
  Lender
}

enum ProjectStatus {
  PreConstruction
  Active
  OnHold
  Completed
}

enum ProjectPhase {
  Planning
  Foundation
  Framing
  MEP
  Finishing
  Closeout
}

enum RFIStatus {
  Open
  InReview
  DraftResponse
  OfficialResponse
  Closed
}

enum RFIPriority {
  Low
  Normal
  High
  Critical
}

enum DocumentCategory {
  Contracts
  Drawings
  Specifications
  Photos
  Reports
  Other
}

enum Discipline {
  Architectural
  Structural
  MEP
  Civil
  General
}

enum WeatherCondition {
  Clear
  PartlyCloudy
  Cloudy
  Rain
  Snow
  Fog
  Wind
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String?
  firstName         String
  lastName          String
  role              UserRole         @default(FieldStaff)
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  projectsManaged   Project[]        @relation("ProjectManager")
  projectsSupervised Project[]       @relation("Superintendent")
  projectsArchitect Project[]        @relation("Architect")
  projectsEngineer  Project[]        @relation("Engineer")
  projectTeams      ProjectTeam[]
  rfisSubmitted        RFI[]                @relation("SubmittedBy")
  rfisAssigned         RFI[]                @relation("AssignedTo")
  rfiResponses         RFIResponse[]
  rfiComments          RFIComment[]
  submittalsSubmitted  Submittal[]          @relation("SubmittedBy")
  submittalsAssigned   Submittal[]          @relation("AssignedTo")
  submittalResponses   SubmittalResponse[]
  submittalComments    SubmittalComment[]
  dailyReports         DailyReport[]
  documentsUploaded    Document[]           @relation("UploadedBy")
  documentVersions     DocumentVersion[]
  changeOrdersRequested ChangeOrder[]       @relation("ChangeOrderRequester")
  changeOrdersApproved  ChangeOrder[]       @relation("ChangeOrderApprover")
  punchItemsIdentified  PunchItem[]         @relation("PunchItemIdentifier")
  punchItemsAssigned    PunchItem[]         @relation("PunchItemAssignee")
  punchItemsVerified    PunchItem[]         @relation("PunchItemVerifier")
  designRequestsSubmitted DesignRequest[]   @relation("DesignRequestSubmittedBy")
  designRequestsAssigned  DesignRequest[]   @relation("DesignRequestAssignedTo")
  designTasksAssigned     DesignTask[]      @relation("DesignTaskAssignedTo")
  
  // BuildOS AI Relations
  documentAnalyses        DocumentAnalysis[]
  crmIntegrations         CRMIntegration[]
  aiProjectPlans          AIProjectPlan[]
  accountingIntegrations  AccountingIntegration[]
  roiCalculations         ROICalculation[]
  
  // Notification & Activity Relations
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  activities              Activity[]
  
  // Time Tracking & Labor Relations
  crewMemberships         CrewMember[]
  timeEntries             TimeEntry[]
  timeEntriesApproved     TimeEntry[]           @relation("TimeEntryApprover")
  
  // Material Management Relations
  materialRequisitions    MaterialRequisition[]
  
  // Work Order Relations
  workOrdersAssigned      WorkOrder[]           @relation("WorkOrderAssignee")
  workOrdersCreated       WorkOrder[]           @relation("WorkOrderCreator")
  workOrdersVerified      WorkOrder[]           @relation("WorkOrderVerifier")
  
  // Budget & Financial Relations
  transactionsSubmitted   BudgetTransaction[]   @relation("TransactionSubmitter")
  transactionsApproved    BudgetTransaction[]   @relation("TransactionApprover")
  
  // Gantt Task Relations
  ganttTasksAssigned      GanttTask[]           @relation("GanttTaskAssignee")
  
  // Draw Request Relations
  drawRequestsSubmitted   DrawRequest[]         @relation("DrawRequestSubmitter")
  drawRequestsReviewed    DrawRequest[]         @relation("DrawRequestReviewer")
  drawRequestsApproved    DrawRequest[]         @relation("DrawRequestApprover")
  
  // Lender Access
  lenderAccess            LenderAccess[]
  
  // Maintenance Relations
  maintenanceAssigned     MaintenanceWorkOrder[] @relation("MaintenanceAssignee")
  
  // NextAuth fields
  properties            Property[]
  accounts          Account[]
  sessions          Session[]
  name              String?
  phone             String?
  companyName       String?
}

model Project {
  id                  String         @id @default(cuid())
  name                String
  client              String
  projectNumber       String         @unique
  address             String
  city                String?
  state               String?
  zipCode             String?
  startDate           DateTime
  estimatedCompletion DateTime
  actualCompletion    DateTime?
  budget              Float
  status              ProjectStatus  @default(PreConstruction)
  phase               ProjectPhase   @default(Planning)
  description         String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  
  // Team members
  projectManagerId    String?
  projectManager      User?          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  superintendentId    String?
  superintendent      User?          @relation("Superintendent", fields: [superintendentId], references: [id])
  architectId         String?
  architect           User?          @relation("Architect", fields: [architectId], references: [id])
  engineerId          String?
  engineer            User?          @relation("Engineer", fields: [engineerId], references: [id])
  
  // Relations
  team                ProjectTeam[]
  rfis                RFI[]
  submittals          Submittal[]
  dailyReports        DailyReport[]
  documents           Document[]
  changeOrders        ChangeOrder[]
  punchItems          PunchItem[]
  properties          Property[]
  designRequests      DesignRequest[]
  
  // BuildOS AI Relations
  documentAnalyses    DocumentAnalysis[]
  aiProjectPlan       AIProjectPlan?
  roiCalculations     ROICalculation[]
  
  // Activity & Tracking Relations
  activities          Activity[]
  timeEntries         TimeEntry[]
  equipment           Equipment[]           @relation("EquipmentCurrentProject")
  materialRequisitions MaterialRequisition[]
  
  // Phase 1 & 2 Relations
  workOrders          WorkOrder[]
  budgetCategories    BudgetCategory[]
  budgetTransactions  BudgetTransaction[]
  ganttTasks          GanttTask[]
  drawRequests        DrawRequest[]
  lenderAccess        LenderAccess[]
}

model ProjectTeam {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, userId])
}

model RFI {
  id                  String       @id @default(cuid())
  rfiNumber           String       @unique
  projectId           String
  subject             String
  question            String       @db.Text
  drawingReference    String?
  specSection         String?
  priority            RFIPriority  @default(Normal)
  status              RFIStatus    @default(Open)
  dueDate             DateTime?
  costImpact          Boolean      @default(false)
  scheduleImpact      Boolean      @default(false)
  estimatedDelayDays  Int?
  submittedById       String
  assignedToId        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  closedAt            DateTime?
  
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy         User         @relation("SubmittedBy", fields: [submittedById], references: [id])
  assignedTo          User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  responses           RFIResponse[]
  comments            RFIComment[]
  attachments         String[]     @default([])
  distributionList    String[]     @default([])
}

model RFIResponse {
  id          String   @id @default(cuid())
  rfiId       String
  response    String   @db.Text
  respondedById String
  isDraft     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  rfi         RFI      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  respondedBy User     @relation(fields: [respondedById], references: [id])
}

model RFIComment {
  id        String   @id @default(cuid())
  rfiId     String
  comment   String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  
  rfi       RFI      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model DailyReport {
  id                      String           @id @default(cuid())
  projectId               String
  date                    DateTime
  submittedById           String
  
  // Weather
  weatherCondition        WeatherCondition?
  temperatureHigh         Float?
  temperatureLow          Float?
  precipitation           Float?
  windSpeed               Float?
  
  // Workforce
  contractorWorkers       Int?             @default(0)
  subcontractorWorkers    Int?             @default(0)
  tradesOnSite            String[]         @default([])
  
  // Work Performed
  workPerformed           String?          @db.Text
  equipmentOnSite         String[]         @default([])
  materialsDelivered      String[]         @default([])
  
  // Safety
  incidentsCount          Int?             @default(0)
  nearMissesCount         Int?             @default(0)
  safetyViolations        String[]         @default([])
  ppeComplianceStatus     String?
  
  // Issues and Delays
  issuesAndDelays         String?          @db.Text
  
  // Photos
  photos                  String[]         @default([])
  
  // Inspections
  inspectionsConducted    String[]         @default([])
  
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy             User             @relation(fields: [submittedById], references: [id])
  
  @@unique([projectId, date])
}

model Submittal {
  id                 String              @id @default(cuid())
  submittalNumber    String              @unique
  title              String
  specSection        String?
  type               SubmittalType       @default(ProductData)
  description        String?
  status             SubmittalStatus     @default(ContractorReview)
  reviewStatus       ReviewStatus?
  priority           RFIPriority         @default(Normal)
  
  // Dates
  submittedDate      DateTime            @default(now())
  requiredOnSiteDate DateTime?
  dueDate            DateTime?
  approvedDate       DateTime?
  
  // Relationships
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  submittedById      String
  submittedBy        User                @relation("SubmittedBy", fields: [submittedById], references: [id])
  
  assignedToId       String?
  assignedTo         User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  // Lead time
  leadTimeDays       Int?
  
  // Workflow tracking
  currentStep        String              @default("contractor_review")
  
  // Review comments
  reviewComments     String?
  
  // Versions and responses
  responses          SubmittalResponse[]
  comments           SubmittalComment[]
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model SubmittalResponse {
  id            String     @id @default(cuid())
  submittalId   String
  submittal     Submittal  @relation(fields: [submittalId], references: [id], onDelete: Cascade)
  
  response      String     @db.Text
  reviewStatus  ReviewStatus
  isDraft       Boolean    @default(false)
  
  respondedById String
  respondedBy   User       @relation(fields: [respondedById], references: [id])
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SubmittalComment {
  id          String    @id @default(cuid())
  submittalId String
  submittal   Submittal @relation(fields: [submittalId], references: [id], onDelete: Cascade)
  
  comment     String    @db.Text
  
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime  @default(now())
}

enum SubmittalType {
  ProductData
  ShopDrawings
  Samples
  MockUps
  DesignData
  TestReports
  Certificates
  Manuals
  Warranties
  Other
}

enum SubmittalStatus {
  ContractorReview
  SubmittedToArchitect
  ArchitectReview
  EngineerReview
  OwnerReview
  FinalApproval
  Closed
}

enum ReviewStatus {
  Approved
  ApprovedAsNoted
  ReviseAndResubmit
  Rejected
}

model Document {
  id            String            @id @default(cuid())
  projectId     String
  filename      String
  category      DocumentCategory
  discipline    Discipline
  cloudStoragePath String
  isPublic      Boolean           @default(false)
  isCurrent     Boolean           @default(true)
  uploadedById  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy    User              @relation("UploadedBy", fields: [uploadedById], references: [id])
  versions      DocumentVersion[]
  
  // BuildOS AI Relations
  analyses      DocumentAnalysis[]
}

model DocumentVersion {
  id              String   @id @default(cuid())
  documentId      String
  versionNumber   Int
  cloudStoragePath String
  isPublic        Boolean  @default(false)
  changeNotes     String?  @db.Text
  uploadedById    String
  createdAt       DateTime @default(now())
  
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy      User     @relation(fields: [uploadedById], references: [id])
  
  @@unique([documentId, versionNumber])
}

// Budget & Change Order models
model ChangeOrder {
  id                String            @id @default(cuid())
  changeOrderNumber String            @unique
  title             String
  description       String            @db.Text
  type              ChangeOrderType   @default(Scope)
  status            ChangeOrderStatus @default(Draft)
  priority          RFIPriority       @default(Normal)
  
  // Financial
  proposedCost      Float
  approvedCost      Float?
  actualCost        Float?
  
  // Dates
  requestedDate     DateTime          @default(now())
  approvedDate      DateTime?
  completedDate     DateTime?
  
  // Impact
  scheduleImpact    Int?              // Days added/reduced
  reason            String?           @db.Text
  justification     String?           @db.Text
  
  // Relations
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  requestedById     String
  requestedBy       User              @relation("ChangeOrderRequester", fields: [requestedById], references: [id])
  
  approvedById      String?
  approvedBy        User?             @relation("ChangeOrderApprover", fields: [approvedById], references: [id])
  
  attachments       String[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// Punch List models
model PunchItem {
  id                String           @id @default(cuid())
  itemNumber        String           @unique
  title             String
  description       String           @db.Text
  location          String
  trade             String?
  status            PunchItemStatus  @default(Open)
  priority          RFIPriority      @default(Normal)
  
  // Dates
  identifiedDate    DateTime         @default(now())
  dueDate           DateTime?
  completedDate     DateTime?
  verifiedDate      DateTime?
  
  // Cost tracking
  estimatedCost     Float?
  actualCost        Float?
  
  // Relations
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  identifiedById    String
  identifiedBy      User             @relation("PunchItemIdentifier", fields: [identifiedById], references: [id])
  
  assignedToId      String?
  assignedTo        User?            @relation("PunchItemAssignee", fields: [assignedToId], references: [id])
  
  verifiedById      String?
  verifiedBy        User?            @relation("PunchItemVerifier", fields: [verifiedById], references: [id])
  
  attachments       String[]
  notes             String?          @db.Text
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// Enums
enum ChangeOrderType {
  Scope
  Schedule
  Budget
  Design
  Unforeseen
  ClientRequested
  RegulatoryCompliance
  Other
}

enum ChangeOrderStatus {
  Draft
  Submitted
  UnderReview
  Approved
  Rejected
  OnHold
  Implemented
}

enum PunchItemStatus {
  Open
  InProgress
  ReadyForReview
  Completed
  Verified
  Deferred
  Disputed
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Real Estate Development Enums
enum AssetType {
  Residential
  Multifamily
  MixedUse
  Industrial
  Agricultural
  SpecialPurpose
}

enum DevelopmentStage {
  PreDevelopment
  Construction
  Stabilized
  Exit
}

enum StatusIndicator {
  Green
  Yellow
  Red
}

// Real Estate Development Property Model
model Property {
  id                      String            @id @default(uuid())
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Property Profile
  name                    String
  street                  String
  city                    String
  state                   String
  zip                     String
  assetType               AssetType
  developmentStage        DevelopmentStage
  units                   Int?
  squareFeet              Int?
  acquisitionDate         DateTime?
  holdPeriodYears         Int?

  // Executive Summary
  purchasePrice           Float
  totalProjectCost        Float
  equityInvested          Float
  debtAmount              Float
  targetIRR               Float?
  targetCashOnCash        Float?
  statusIndicator         StatusIndicator   @default(Green)

  // Capital Stack
  hardCosts               Float             @default(0)
  softCosts               Float             @default(0)
  financingCosts          Float             @default(0)
  contingency             Float             @default(0)

  // Debt Details
  debtInterestRate        Float?
  debtTermYears           Int?
  debtAmortizationYears   Int?

  // Operating Assumptions
  avgMonthlyRentPerUnit   Float             @default(0)
  otherIncomeMonthly      Float             @default(0)
  vacancyRate             Float             @default(0.05)
  expenseRatio            Float             @default(0.40)
  annualRentGrowthRate    Float             @default(0.03)
  annualExpenseGrowthRate Float             @default(0.03)

  // Exit Assumptions
  exitCapRate             Float             @default(0.06)
  saleCostPercentage      Float             @default(0.05)

  // Relationships
  projectId               String?
  project                 Project?          @relation(fields: [projectId], references: [id])
  
  ownerId                 String?
  owner                   User?             @relation(fields: [ownerId], references: [id])
  
  // Tenant & Unit Relations
  tenants                 Tenant[]
  propertyUnits           Unit[]
  maintenanceWorkOrders   MaintenanceWorkOrder[]

  // Financial snapshots can be stored separately if needed
  @@index([assetType])
  @@index([developmentStage])
  @@index([projectId])
}

enum DesignRequestStatus {
  Draft
  Submitted
  AIProcessing
  UnderReview
  ClientReview
  RevisionRequired
  Approved
  InDesign
  Rendering
  Completed
  Cancelled
}

enum DesignProjectType {
  Residential
  Commercial
  Industrial
  MixedUse
  Renovation
  LandscapingInterior
}

enum DesignTimeline {
  Rush
  Standard
  Flexible
}

enum DesignTaskType {
  Architectural
  Structural
  MEPDesign
  InteriorDesign
  Landscaping
  Rendering
  ThreeD_Modeling
  Documentation
}

enum TaskStatus {
  Pending
  Queued
  Processing
  Completed
  Failed
  Cancelled
}

model DesignRequest {
  id                    String                 @id @default(cuid())
  requestNumber         String                 @unique
  
  // Client Information
  clientName            String
  clientEmail           String
  clientPhone           String?
  
  // Project Details
  projectName           String
  projectType           DesignProjectType
  description           String                 @db.Text
  requirements          String                 @db.Text
  siteDetails           String?                @db.Text
  budget                Float?
  timeline              DesignTimeline
  
  // Status & Tracking
  status                DesignRequestStatus    @default(Draft)
  submittedAt           DateTime?
  approvedAt            DateTime?
  completedAt           DateTime?
  
  // AI Analysis Results
  aiAnalysisCompleted   Boolean                @default(false)
  designConcept         String?                @db.Text
  styleRecommendations  String?                @db.Text
  spatialLayout         String?                @db.Text
  materialSuggestions   String?                @db.Text
  sustainabilityFeatures String?               @db.Text
  budgetConsiderations  String?                @db.Text
  timelineEstimate      String?                @db.Text
  visualizationPrompt   String?                @db.Text
  
  // Design Visualization
  visualizationUrl      String?
  driveFileId           String?
  driveFileLink         String?
  
  // Client Feedback
  revisionNotes         String?                @db.Text
  revisionCount         Int                    @default(0)
  
  // External Platform Integration
  externalRequestId     String?                // ID from AI design platform
  externalStatus        String?
  webhookUrl            String?
  lastWebhookSync       DateTime?
  
  // Timestamps
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  // Relationships
  projectId             String?
  project               Project?               @relation(fields: [projectId], references: [id])
  
  submittedById         String?
  submittedBy           User?                  @relation("DesignRequestSubmittedBy", fields: [submittedById], references: [id])
  
  assignedToId          String?
  assignedTo            User?                  @relation("DesignRequestAssignedTo", fields: [assignedToId], references: [id])
  
  tasks                 DesignTask[]
  
  @@index([status])
  @@index([projectType])
  @@index([projectId])
  @@index([submittedById])
  @@index([createdAt])
}

model DesignTask {
  id                    String                 @id @default(cuid())
  
  // Task Details
  taskType              DesignTaskType
  title                 String
  description           String                 @db.Text
  priority              RFIPriority            @default(Normal)
  
  // Status & Tracking
  status                TaskStatus             @default(Pending)
  startedAt             DateTime?
  completedAt           DateTime?
  
  // External Platform Integration
  sentToExternalPlatform Boolean               @default(false)
  externalTaskId        String?                // ID from AI design platform
  externalStatus        String?
  externalResponse      String?                @db.Text
  webhookPayload        String?                @db.Text
  webhookResponse       String?                @db.Text
  lastSyncAt            DateTime?
  
  // Results
  resultUrl             String?
  resultData            String?                @db.Text
  resultFiles           String[]               @default([])
  
  // Error Handling
  errorMessage          String?                @db.Text
  retryCount            Int                    @default(0)
  
  // Timestamps
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  // Relationships
  designRequestId       String
  designRequest         DesignRequest          @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  
  assignedToId          String?
  assignedTo            User?                  @relation("DesignTaskAssignedTo", fields: [assignedToId], references: [id])
  
  @@index([status])
  @@index([taskType])
  @@index([designRequestId])
  @@index([createdAt])
}

// ==============================
// BuildOS AI Features
// ==============================

enum AnalysisType {
  General
  Safety
  Cost
  Timeline
  Compliance
  Quality
}

enum CRMProvider {
  Salesforce
  HubSpot
  Zoho
  Pipedrive
  Custom
}

model DocumentAnalysis {
  id                    String                 @id @default(cuid())
  
  // Document Reference
  documentId            String?
  document              Document?              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Project Reference
  projectId             String
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // User Reference
  userId                String
  user                  User                   @relation(fields: [userId], references: [id])
  
  // Analysis Details
  analysisType          AnalysisType           @default(General)
  documentText          String                 @db.Text
  analysisResult        String                 @db.Text
  aiModel               String?                // e.g., "gpt-4", "minimax"
  confidence            Float?                 // 0.0 to 1.0
  
  // Metadata
  processingTime        Int?                   // milliseconds
  tokensUsed            Int?
  
  // Timestamps
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  @@index([projectId])
  @@index([userId])
  @@index([analysisType])
  @@index([createdAt])
}

model CRMIntegration {
  id                    String                 @id @default(cuid())
  
  // User Reference
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Integration Details
  provider              CRMProvider
  name                  String                 // User-friendly name
  apiKey                String?                // Encrypted API key
  apiSecret             String?                // For OAuth
  accessToken           String?                // OAuth access token
  refreshToken          String?                // OAuth refresh token
  webhookUrl            String?                // For custom integrations
  
  // Configuration
  config                String?                @db.Text // JSON config
  
  // Status
  isActive              Boolean                @default(true)
  lastSyncAt            DateTime?
  lastError             String?                @db.Text
  syncCount             Int                    @default(0)
  
  // Timestamps
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  @@index([userId])
  @@index([provider])
  @@index([isActive])
}

model AIProjectPlan {
  id                    String                 @id @default(cuid())
  
  // Project Reference
  projectId             String                 @unique
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // User Reference
  userId                String
  user                  User                   @relation(fields: [userId], references: [id])
  
  // Plan Details
  planData              String                 @db.Text // JSON structure
  phases                String                 @db.Text // JSON array of phases
  milestones            String                 @db.Text // JSON array of milestones
  riskAnalysis          String?                @db.Text
  budgetBreakdown       String?                @db.Text // JSON budget data
  
  // AI Generation
  aiModel               String?
  promptUsed            String?                @db.Text
  generationTime        Int?                   // milliseconds
  
  // Version Control
  version               Int                    @default(1)
  
  // Timestamps
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

// ==============================
// Accounting & Financial Integration
// ==============================

enum AccountingProvider {
  QuickBooks
  Xero
  FreshBooks
  Sage
  NetSuite
  Custom
}

model AccountingIntegration {
  id                    String                 @id @default(cuid())
  
  // User Reference
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Integration Details
  provider              AccountingProvider
  name                  String                 // User-friendly name
  companyId             String?                // Company/Realm ID for multi-tenant accounting systems
  apiKey                String?                // Encrypted API key
