// EVENT SPINE & QUANTUM LEDGER MODELS
// ========================================

enum EventType {
  MilestoneCompleted
  CapitalDrawRequested
  DrawApproved
  DrawDenied
  DrawFunded
  InspectionCompleted
  BudgetThresholdAlert
  RiskFlagged
  ComplianceUpdated
  JournalEntryCreated
  PaymentProcessed
  ContractSigned
  ChangeOrderApproved
}

enum MilestoneType {
  SitePrep
  FoundationComplete
  FramingComplete
  RoofComplete
  MEPRoughIn
  InsulationComplete
  DrywallComplete
  FinishesComplete
  FinalInspection
  CertificateOfOccupancy
  ProjectCloseout
  Custom
}

enum LedgerEntryType {
  Debit
  Credit
}

enum ApprovalStatus {
  Pending
  AutoApproved
  HITLRequired
  CommitteeRequired
  Approved
  Denied
  Escalated
}

model ProjectEvent {
  id              String      @id @default(cuid())
  eventType       EventType
  eventVersion    String      @default("1.0.0")
  occurredAt      DateTime    @default(now())
  producer        String      @default("SiteSyncOS")
  projectId       String
  correlationId   String?
  causationId     String?
  confidence      Float?      @default(1.0)
  data            Json
  policyData      Json?
  auditData       Json?
  processed       Boolean     @default(false)
  processedAt     DateTime?
  createdAt       DateTime    @default(now())
  
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ledgerEntries   LedgerEntry[]
  auditPack       AuditPack?

  @@index([projectId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([correlationId])
}

model ProjectMilestone {
  id                String          @id @default(cuid())
  projectId         String
  milestoneType     MilestoneType
  name              String
  description       String?
  scheduledDate     DateTime?
  completedDate     DateTime?
  verifiedDate      DateTime?
  verifiedById      String?
  verificationMethod String?
  percentComplete   Float           @default(0)
  evidenceLinks     String[]        @default([])
  status            String          @default("Pending")
  drawEligible      Boolean         @default(false)
  budgetedCost      Float?
  actualCost        Float?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifiedBy        User?           @relation("MilestoneVerifier", fields: [verifiedById], references: [id])

  @@index([projectId])
  @@index([milestoneType])
  @@index([status])
}

model LedgerEntry {
