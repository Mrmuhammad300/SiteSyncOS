  approvalStatus    ApprovalStatus  @default(Pending)
  autoApproveMax    Float           @default(25000)
  hitlRequiredMin   Float           @default(25001)
  committeeMin      Float           @default(250001)
  evidenceComplete  Boolean         @default(false)
  policyValidated   Boolean         @default(false)
  riskScore         Float?
  riskFlags         String[]        @default([])
  conditions        String[]        @default([])
  approvers         Json?
  initiatedById     String
  initiatedAt       DateTime        @default(now())
  decidedAt         DateTime?
  decidedById       String?
  decisionNotes     String?
  auditPackRef      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  drawRequest       DrawRequest     @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  initiatedBy       User            @relation("WorkflowInitiator", fields: [initiatedById], references: [id])
  decidedBy         User?           @relation("WorkflowDecider", fields: [decidedById], references: [id])

  @@index([approvalStatus])
  @@index([initiatedAt])
}

model AuditPack {
  id                String          @id @default(cuid())
  packNumber        String          @unique
  projectId         String
  eventId           String?         @unique
  drawRequestId     String?
  title             String
  description       String?
  evidenceLinks     String[]        @default([])
  lineageRefs       String[]        @default([])
  complianceStatus  String          @default("Pending")
  retentionPeriod   Int             @default(7)
  generatedAt       DateTime        @default(now())
  generatedById     String?
  cloudStoragePath  String?
  isPublic          Boolean         @default(false)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event             ProjectEvent?   @relation(fields: [eventId], references: [id])

  @@index([projectId])
  @@index([complianceStatus])
  @@index([generatedAt])
}

model CashflowForecast {
  id                String          @id @default(cuid())
  projectId         String
  forecastDate      DateTime
  periodStart       DateTime
  periodEnd         DateTime
  projectedInflow   Float           @default(0)
  projectedOutflow  Float           @default(0)
  netCashflow       Float           @default(0)
  cumulativeBalance Float           @default(0)
  budgetVariance    Float           @default(0)
  costToComplete    Float?
  runwayMonths      Float?
  riskFactors       Json?
  assumptions       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([forecastDate])
  @@index([periodStart])
}

