generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/construction_crm_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  password                String?
  firstName               String
  lastName                String
  role                    UserRole                @default(FieldStaff)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  emailVerified           DateTime?
  image                   String?
  name                    String?
  companyName             String?
  phone                   String?
  aiProjectPlans          AIProjectPlan[]
  accounts                Account[]
  accountingIntegrations  AccountingIntegration[]
  activities              Activity[]
  transactionsApproved    BudgetTransaction[]     @relation("TransactionApprover")
  transactionsSubmitted   BudgetTransaction[]     @relation("TransactionSubmitter")
  crmIntegrations         CRMIntegration[]
  changeOrdersApproved    ChangeOrder[]           @relation("ChangeOrderApprover")
  changeOrdersRequested   ChangeOrder[]           @relation("ChangeOrderRequester")
  crewMemberships         CrewMember[]
  dailyReports            DailyReport[]
  designRequestsAssigned  DesignRequest[]         @relation("DesignRequestAssignedTo")
  designRequestsSubmitted DesignRequest[]         @relation("DesignRequestSubmittedBy")
  designTasksAssigned     DesignTask[]            @relation("DesignTaskAssignedTo")
  documentsUploaded       Document[]              @relation("UploadedBy")
  documentAnalyses        DocumentAnalysis[]
  documentVersions        DocumentVersion[]
  drawRequestsApproved    DrawRequest[]           @relation("DrawRequestApprover")
  drawRequestsReviewed    DrawRequest[]           @relation("DrawRequestReviewer")
  drawRequestsSubmitted   DrawRequest[]           @relation("DrawRequestSubmitter")
  ganttTasksAssigned      GanttTask[]             @relation("GanttTaskAssignee")
  lenderAccess            LenderAccess[]
  maintenanceAssigned     MaintenanceWorkOrder[]  @relation("MaintenanceAssignee")
  materialRequisitions    MaterialRequisition[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  projectsArchitect       Project[]               @relation("Architect")
  projectsEngineer        Project[]               @relation("Engineer")
  projectsManaged         Project[]               @relation("ProjectManager")
  projectsSupervised      Project[]               @relation("Superintendent")
  projectTeams            ProjectTeam[]
  properties              Property[]
  punchItemsAssigned      PunchItem[]             @relation("PunchItemAssignee")
  punchItemsIdentified    PunchItem[]             @relation("PunchItemIdentifier")
  punchItemsVerified      PunchItem[]             @relation("PunchItemVerifier")
  rfisAssigned            RFI[]                   @relation("AssignedTo")
  rfisSubmitted           RFI[]                   @relation("SubmittedBy")
  rfiComments             RFIComment[]
  rfiResponses            RFIResponse[]
  roiCalculations         ROICalculation[]
  sessions                Session[]
  submittalsAssigned      Submittal[]             @relation("AssignedTo")
  submittalsSubmitted     Submittal[]             @relation("SubmittedBy")
  submittalComments       SubmittalComment[]
  submittalResponses      SubmittalResponse[]
  timeEntriesApproved     TimeEntry[]             @relation("TimeEntryApprover")
  timeEntries             TimeEntry[]
  workOrdersAssigned      WorkOrder[]             @relation("WorkOrderAssignee")
  workOrdersCreated       WorkOrder[]             @relation("WorkOrderCreator")
  workOrdersVerified      WorkOrder[]             @relation("WorkOrderVerifier")
  milestonesVerified      ProjectMilestone[]      @relation("MilestoneVerifier")
  workflowsInitiated      DrawApprovalWorkflow[]  @relation("WorkflowInitiator")
  workflowsDecided        DrawApprovalWorkflow[]  @relation("WorkflowDecider")
  agentExecutionsApproved AgentExecution[]
}

model Project {
  id                   String                @id @default(cuid())
  name                 String
  client               String
  projectNumber        String                @unique
  address              String
  city                 String?
  state                String?
  zipCode              String?
  startDate            DateTime
  estimatedCompletion  DateTime
  actualCompletion     DateTime?
  budget               Float
  status               ProjectStatus         @default(PreConstruction)
  phase                ProjectPhase          @default(Planning)
  description          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  projectManagerId     String?
  superintendentId     String?
  architectId          String?
  engineerId           String?
  floodZone            String?
  hazardTypes          String?
  lastRiskAssessment   DateTime?
  latitude             Float?
  longitude            Float?
  riskScore            Int?
  riskZone             RiskZone?
  aiProjectPlan        AIProjectPlan?
  activities           Activity[]
  budgetCategories     BudgetCategory[]
  budgetTransactions   BudgetTransaction[]
  changeOrders         ChangeOrder[]
  dailyReports         DailyReport[]
  designRequests       DesignRequest[]
  documents            Document[]
  documentAnalyses     DocumentAnalysis[]
  drawRequests         DrawRequest[]
  equipment            Equipment[]           @relation("EquipmentCurrentProject")
  ganttTasks           GanttTask[]
  lenderAccess         LenderAccess[]
  materialRequisitions MaterialRequisition[]
  architect            User?                 @relation("Architect", fields: [architectId], references: [id])
  engineer             User?                 @relation("Engineer", fields: [engineerId], references: [id])
  projectManager       User?                 @relation("ProjectManager", fields: [projectManagerId], references: [id])
  superintendent       User?                 @relation("Superintendent", fields: [superintendentId], references: [id])
  team                 ProjectTeam[]
  properties           Property[]
  punchItems           PunchItem[]
  rfis                 RFI[]
  roiCalculations      ROICalculation[]
  submittals           Submittal[]
  timeEntries          TimeEntry[]
  workOrders           WorkOrder[]
  events               ProjectEvent[]
  milestones           ProjectMilestone[]
  ledgerEntries        LedgerEntry[]
  auditPacks           AuditPack[]
  cashflowForecasts    CashflowForecast[]
  agentExecutions      AgentExecution[]
  agentMemories        AgentMemory[]
}

model ProjectTeam {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model RFI {
  id                 String        @id @default(cuid())
  rfiNumber          String        @unique
  projectId          String
  subject            String
  question           String
  drawingReference   String?
  specSection        String?
  priority           RFIPriority   @default(Normal)
  status             RFIStatus     @default(Open)
  dueDate            DateTime?
  costImpact         Boolean       @default(false)
  scheduleImpact     Boolean       @default(false)
  estimatedDelayDays Int?
  submittedById      String
  assignedToId       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  closedAt           DateTime?
  attachments        String[]      @default([])
  distributionList   String[]      @default([])
  assignedTo         User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy        User          @relation("SubmittedBy", fields: [submittedById], references: [id])
  comments           RFIComment[]
  responses          RFIResponse[]
}

model RFIResponse {
  id            String   @id @default(cuid())
  rfiId         String
  response      String
  respondedById String
  isDraft       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  respondedBy   User     @relation(fields: [respondedById], references: [id])
  rfi           RFI      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
}

model RFIComment {
  id        String   @id @default(cuid())
  rfiId     String
  comment   String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  rfi       RFI      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id                   String            @id @default(cuid())
  projectId            String
  date                 DateTime
  submittedById        String
  weatherCondition     WeatherCondition?
  temperatureHigh      Float?
  temperatureLow       Float?
  precipitation        Float?
  windSpeed            Float?
  contractorWorkers    Int?              @default(0)
  subcontractorWorkers Int?              @default(0)
  tradesOnSite         String[]          @default([])
  workPerformed        String?
  equipmentOnSite      String[]          @default([])
  materialsDelivered   String[]          @default([])
  incidentsCount       Int?              @default(0)
  nearMissesCount      Int?              @default(0)
  safetyViolations     String[]          @default([])
  ppeComplianceStatus  String?
  issuesAndDelays      String?
  photos               String[]          @default([])
  inspectionsConducted String[]          @default([])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy          User              @relation(fields: [submittedById], references: [id])

  @@unique([projectId, date])
}

model Submittal {
  id                 String              @id @default(cuid())
  submittalNumber    String              @unique
  title              String
  specSection        String?
  type               SubmittalType       @default(ProductData)
  description        String?
  status             SubmittalStatus     @default(ContractorReview)
  reviewStatus       ReviewStatus?
  priority           RFIPriority         @default(Normal)
  submittedDate      DateTime            @default(now())
  requiredOnSiteDate DateTime?
  dueDate            DateTime?
  approvedDate       DateTime?
  projectId          String
  submittedById      String
  assignedToId       String?
  leadTimeDays       Int?
  currentStep        String              @default("contractor_review")
  reviewComments     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignedTo         User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy        User                @relation("SubmittedBy", fields: [submittedById], references: [id])
  comments           SubmittalComment[]
  responses          SubmittalResponse[]
}

model SubmittalResponse {
  id            String       @id @default(cuid())
  submittalId   String
  response      String
  reviewStatus  ReviewStatus
  isDraft       Boolean      @default(false)
  respondedById String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  respondedBy   User         @relation(fields: [respondedById], references: [id])
  submittal     Submittal    @relation(fields: [submittalId], references: [id], onDelete: Cascade)
}

model SubmittalComment {
  id          String    @id @default(cuid())
  submittalId String
  comment     String
  authorId    String
  createdAt   DateTime  @default(now())
  author      User      @relation(fields: [authorId], references: [id])
  submittal   Submittal @relation(fields: [submittalId], references: [id], onDelete: Cascade)
}

model Document {
  id               String             @id @default(cuid())
  projectId        String
  filename         String
  category         DocumentCategory
  discipline       Discipline
  cloudStoragePath String
  isPublic         Boolean            @default(false)
  isCurrent        Boolean            @default(true)
  uploadedById     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy       User               @relation("UploadedBy", fields: [uploadedById], references: [id])
  analyses         DocumentAnalysis[]
  versions         DocumentVersion[]
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  versionNumber    Int
  cloudStoragePath String
  isPublic         Boolean  @default(false)
  changeNotes      String?
  uploadedById     String
  createdAt        DateTime @default(now())
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, versionNumber])
}

model ChangeOrder {
  id                String            @id @default(cuid())
  changeOrderNumber String            @unique
  title             String
  description       String
  type              ChangeOrderType   @default(Scope)
  status            ChangeOrderStatus @default(Draft)
  priority          RFIPriority       @default(Normal)
  proposedCost      Float
  approvedCost      Float?
  actualCost        Float?
  requestedDate     DateTime          @default(now())
  approvedDate      DateTime?
  completedDate     DateTime?
  scheduleImpact    Int?
  reason            String?
  justification     String?
  projectId         String
  requestedById     String
  approvedById      String?
  attachments       String[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  approvedBy        User?             @relation("ChangeOrderApprover", fields: [approvedById], references: [id])
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy       User              @relation("ChangeOrderRequester", fields: [requestedById], references: [id])
}

model PunchItem {
  id             String          @id @default(cuid())
  itemNumber     String          @unique
  title          String
  description    String
  location       String
  trade          String?
  status         PunchItemStatus @default(Open)
  priority       RFIPriority     @default(Normal)
  identifiedDate DateTime        @default(now())
  dueDate        DateTime?
  completedDate  DateTime?
  verifiedDate   DateTime?
  estimatedCost  Float?
  actualCost     Float?
  projectId      String
  identifiedById String
  assignedToId   String?
  verifiedById   String?
  attachments    String[]
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedTo     User?           @relation("PunchItemAssignee", fields: [assignedToId], references: [id])
  identifiedBy   User            @relation("PunchItemIdentifier", fields: [identifiedById], references: [id])
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifiedBy     User?           @relation("PunchItemVerifier", fields: [verifiedById], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id                      String                 @id @default(uuid())
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  name                    String
  street                  String
  city                    String
  state                   String
  zip                     String
  assetType               AssetType
  developmentStage        DevelopmentStage
  units                   Int?
  squareFeet              Int?
  acquisitionDate         DateTime?
  holdPeriodYears         Int?
  purchasePrice           Float
  totalProjectCost        Float
  equityInvested          Float
  debtAmount              Float
  targetIRR               Float?
  targetCashOnCash        Float?
  statusIndicator         StatusIndicator        @default(Green)
  hardCosts               Float                  @default(0)
  softCosts               Float                  @default(0)
  financingCosts          Float                  @default(0)
  contingency             Float                  @default(0)
  debtInterestRate        Float?
  debtTermYears           Int?
  debtAmortizationYears   Int?
  avgMonthlyRentPerUnit   Float                  @default(0)
  otherIncomeMonthly      Float                  @default(0)
  vacancyRate             Float                  @default(0.05)
  expenseRatio            Float                  @default(0.40)
  annualRentGrowthRate    Float                  @default(0.03)
  annualExpenseGrowthRate Float                  @default(0.03)
  exitCapRate             Float                  @default(0.06)
  saleCostPercentage      Float                  @default(0.05)
  projectId               String?
  ownerId                 String?
  floodZone               String?
  hazardTypes             String?
  lastRiskAssessment      DateTime?
  latitude                Float?
  longitude               Float?
  riskScore               Int?
  riskZone                RiskZone?
  maintenanceWorkOrders   MaintenanceWorkOrder[]
  owner                   User?                  @relation(fields: [ownerId], references: [id])
  project                 Project?               @relation(fields: [projectId], references: [id])
  tenants                 Tenant[]
  propertyUnits           Unit[]

  @@index([assetType])
  @@index([developmentStage])
  @@index([projectId])
}

model DesignRequest {
  id                     String              @id @default(cuid())
  requestNumber          String              @unique
  clientName             String
  clientEmail            String
  clientPhone            String?
  projectName            String
  projectType            DesignProjectType
  description            String
  requirements           String
  siteDetails            String?
  budget                 Float?
  timeline               DesignTimeline
  status                 DesignRequestStatus @default(Draft)
  submittedAt            DateTime?
  approvedAt             DateTime?
  completedAt            DateTime?
  aiAnalysisCompleted    Boolean             @default(false)
  designConcept          String?
  styleRecommendations   String?
  spatialLayout          String?
  materialSuggestions    String?
  sustainabilityFeatures String?
  budgetConsiderations   String?
  timelineEstimate       String?
  visualizationPrompt    String?
  visualizationUrl       String?
  driveFileId            String?
  driveFileLink          String?
  revisionNotes          String?
  revisionCount          Int                 @default(0)
  externalRequestId      String?
  externalStatus         String?
  webhookUrl             String?
  lastWebhookSync        DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  projectId              String?
  submittedById          String?
  assignedToId           String?
  assignedTo             User?               @relation("DesignRequestAssignedTo", fields: [assignedToId], references: [id])
  project                Project?            @relation(fields: [projectId], references: [id])
  submittedBy            User?               @relation("DesignRequestSubmittedBy", fields: [submittedById], references: [id])
  tasks                  DesignTask[]

  @@index([status])
  @@index([projectType])
  @@index([projectId])
  @@index([submittedById])
  @@index([createdAt])
}

model DesignTask {
  id                     String         @id @default(cuid())
  taskType               DesignTaskType
  title                  String
  description            String
  priority               RFIPriority    @default(Normal)
  status                 TaskStatus     @default(Pending)
  startedAt              DateTime?
  completedAt            DateTime?
  sentToExternalPlatform Boolean        @default(false)
  externalTaskId         String?
  externalStatus         String?
  externalResponse       String?
  webhookPayload         String?
  webhookResponse        String?
  lastSyncAt             DateTime?
  resultUrl              String?
  resultData             String?
  resultFiles            String[]       @default([])
  errorMessage           String?
  retryCount             Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  designRequestId        String
  assignedToId           String?
  assignedTo             User?          @relation("DesignTaskAssignedTo", fields: [assignedToId], references: [id])
  designRequest          DesignRequest  @relation(fields: [designRequestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([taskType])
  @@index([designRequestId])
  @@index([createdAt])
}

model DocumentAnalysis {
  id             String       @id @default(cuid())
  documentId     String?
  projectId      String
  userId         String
  analysisType   AnalysisType @default(General)
  documentText   String
  analysisResult String
  aiModel        String?
  confidence     Float?
  processingTime Int?
  tokensUsed     Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([analysisType])
  @@index([createdAt])
}

model CRMIntegration {
  id           String      @id @default(cuid())
  userId       String
  provider     CRMProvider
  name         String
  apiKey       String?
  apiSecret    String?
  accessToken  String?
  refreshToken String?
  webhookUrl   String?
  config       String?
  isActive     Boolean     @default(true)
  lastSyncAt   DateTime?
  lastError    String?
  syncCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([isActive])
}

model AIProjectPlan {
  id              String   @id @default(cuid())
  projectId       String   @unique
  userId          String
  planData        String
  phases          String
  milestones      String
  riskAnalysis    String?
  budgetBreakdown String?
  aiModel         String?
  promptUsed      String?
  generationTime  Int?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model AccountingIntegration {
  id              String             @id @default(cuid())
  userId          String
  provider        AccountingProvider
  name            String
  companyId       String?
  apiKey          String?
  apiSecret       String?
  accessToken     String?
  refreshToken    String?
  webhookUrl      String?
  config          String?
  autoSyncEnabled Boolean            @default(false)
  syncFrequency   String?
  isActive        Boolean            @default(true)
  lastSyncAt      DateTime?
  lastError       String?
  syncCount       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([isActive])
}

model ROICalculation {
  id                         String    @id @default(cuid())
  projectId                  String?
  userId                     String
  totalProjectCost           Float
  projectDurationMonths      Int
  numberOfDrawingRevisions   Int
  avgRFIChangeOrderVolume    Float
  avgLaborCostPerHour        Float
  teamSize                   Int
  reworkPercentage           Float
  takeoffErrorRate           Float
  scheduleSlippageWeeks      Int
  claimsDisputesProbability  RiskLevel
  reworkCostSavings          Float?
  takeoffEfficiencySavings   Float?
  scheduleCompressionSavings Float?
  claimsRiskAvoidanceSavings Float?
  totalSavings               Float?
  roiPercentage              Float?
  calculationName            String?
  notes                      String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  project                    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                       User      @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  type        NotificationType
  category    NotificationCategory
  title       String
  message     String
  entityType  String?
  entityId    String?
  actionUrl   String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  emailSent   Boolean              @default(false)
  emailSentAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([category])
}

model NotificationPreference {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  emailRfiResponse          Boolean  @default(true)
  emailRfiAssigned          Boolean  @default(true)
  emailSubmittalResponse    Boolean  @default(true)
  emailSubmittalAssigned    Boolean  @default(true)
  emailChangeOrderApproved  Boolean  @default(true)
  emailPunchItemAssigned    Boolean  @default(true)
  emailDailyReportSubmitted Boolean  @default(false)
  emailDocumentUploaded     Boolean  @default(false)
  emailMentions             Boolean  @default(true)
  inAppAll                  Boolean  @default(true)
  enableDailyDigest         Boolean  @default(false)
  dailyDigestTime           String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String       @id @default(cuid())
  userId      String
  projectId   String?
  type        ActivityType
  description String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
  @@index([type])
}

model Crew {
  id          String       @id @default(cuid())
  name        String
  description String?
  skills      String[]
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     CrewMember[]
  timeEntries TimeEntry[]

  @@index([isActive])
}

model CrewMember {
  id         String    @id @default(cuid())
  crewId     String
  userId     String
  role       String
  hourlyRate Float?
  isActive   Boolean   @default(true)
