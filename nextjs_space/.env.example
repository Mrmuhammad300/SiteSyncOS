# =============================================================================
# SiteSync OS — Environment Variables Template
# =============================================================================
# Copy this file to .env for local development.
# In production (Abacus AI), set each variable in the Secrets panel — never
# commit a file containing real values.
#
# Required variables are marked [REQUIRED].
# Variables with safe defaults are marked [OPTIONAL — default shown].
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connect_timeout=15
DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# [REQUIRED] Random string ≥ 32 chars. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
# [REQUIRED] Canonical URL of your deployment (no trailing slash).
# Local: http://localhost:3000  |  Prod: https://your-app.abacusai.app
NEXTAUTH_URL=http://localhost:3000

# [OPTIONAL] Google OAuth — leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AWS / S3 Storage
# -----------------------------------------------------------------------------
# [REQUIRED] Configured by Abacus AI hosted storage — do not change in prod.
AWS_PROFILE=hosted_storage
AWS_REGION=us-west-2
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# -----------------------------------------------------------------------------
# Webhooks & External Integrations
# -----------------------------------------------------------------------------
# [REQUIRED] Secret for verifying inbound n8n webhook calls.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# [REQUIRED] Full URL of the external design-platform webhook endpoint.
DESIGN_WEBHOOK_URL=

# [REQUIRED] Shared secret for signing/verifying design-platform callbacks.
# Generate with: openssl rand -hex 32
DESIGN_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Cost Analysis APIs
# -----------------------------------------------------------------------------
# [OPTIONAL] 1build Construction Cost Estimation
ONEBUILD_API_URL=https://gateway-external.1build.com
ONEBUILD_API_KEY=

# [OPTIONAL] Gordian RSMeans Cost Data
GORDIAN_API_URL=https://dataapi-sb.gordian.com
GORDIAN_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# TRELLIS 3D Asset Generation
# -----------------------------------------------------------------------------
# [OPTIONAL — defaults to localhost:7860]
TRELLIS_HOST=localhost
TRELLIS_PORT=7860
# Set TRELLIS_URL to override the host+port combination entirely.
TRELLIS_URL=

# -----------------------------------------------------------------------------
# Blender MCP Integration
# -----------------------------------------------------------------------------
# [OPTIONAL — defaults to localhost:9876]
BLENDER_HOST=localhost
BLENDER_PORT=9876

# -----------------------------------------------------------------------------
# Abacus AI Platform
# -----------------------------------------------------------------------------
# [REQUIRED in production] Your Abacus AI API key.
ABACUSAI_API_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# [OPTIONAL] Explicit public URL used by frontend fetch calls.
# Falls back to NEXTAUTH_URL when not set.
NEXT_PUBLIC_APP_URL=

# [OPTIONAL] Comma-separated list of additional allowed CORS origins.
# NEXTAUTH_URL is always included automatically.
# Example: https://staging.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=
